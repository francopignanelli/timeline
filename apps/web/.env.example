# Copy to .env.local (gitignored) and fill in with `infra` stack outputs after `cdk deploy`.
# Not secrets: a Cognito User Pool ID + public app client ID identify the pool but grant no access on their own.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
# TimelineDevApi.ApiUrl output — no trailing slash.
VITE_API_URL=
